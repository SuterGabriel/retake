# Copy to .env. Never commit .env.
ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://retake:retake@localhost:5432/retake
REDIS_URL=redis://localhost:6379/0
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=retake
OBJECT_STORE_ACCESS_KEY=minio
OBJECT_STORE_SECRET_KEY=minio12345

ELEVENLABS_API_KEY=replace-me
ELEVENLABS_DEFAULT_VOICE_ID=replace-me
ELEVENLABS_DEFAULT_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_MONTHLY_BUDGET=50000
GENERATION_CONCURRENCY=3

# Frontend (inlined into the browser bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Host ports used by docker compose (change if something else already listens there)
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
